# Copy to .env (git-ignored) and fill in. Never commit real values.
# App Builder runtime (written by `aio app use`)
AIO_runtime_auth=
AIO_runtime_namespace=
AIO_runtime_apihost=
# Sync service: OAuth server-to-server credential "da-cf-sync" (Developer Console project, Edge Delivery Services API)
CF_SYNC_CLIENT_ID=
CF_SYNC_CLIENT_SECRET=
CF_SYNC_SCOPES=openid,AdobeID,read_organizations,additional_info.projectedProductContext,aem.frontend.all
CF_SYNC_TECH_ACCOUNT_ID=
CF_SYNC_TECH_ACCOUNT_EMAIL=
# aem.live admin API key with the publish role (org level)
AEM_LIVE_API_KEY=
AEM_LIVE_API_KEY_ID=
AEM_LIVE_API_KEY_SCOPE=
